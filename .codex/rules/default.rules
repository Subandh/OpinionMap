prefix_rule(pattern=["rg", "-n", "-i", "-C", "2", "under[[:space:]-]+progress|not[[:space:]-]+hosted", "html-before-cleanup", "html-2026-10-09", "-g", "*.html", "-g", "*.js", "-g", "*.css", "-g", "*.svg", "-g", "*.txt"], decision="allow")
prefix_rule(pattern=["rg", "--files", "-g", "!*node_modules*", "-g", "!*.lock"], decision="allow")
prefix_rule(pattern=["sed", "-n"], decision="allow")
prefix_rule(pattern=["rg", "-n"], decision="allow")
prefix_rule(pattern=["git", "status", "--short"], decision="allow")
prefix_rule(pattern=["pwd"], decision="allow")
prefix_rule(pattern=["rg", "--files", "-g", "AGENTS.md", "-g", "!private/python/venv/**", "-g", "!private/python/__pycache__/**", "-g", "!node_modules/**"], decision="allow")
prefix_rule(pattern=["rg", "--files", "html", "private", "-g", "!private/python/venv/**", "-g", "!private/python/__pycache__/**"], decision="allow")
prefix_rule(pattern=["cat", "private/schema.sql"], decision="allow")
